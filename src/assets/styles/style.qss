/* ═══════════════════════════════════════════════════════════════════════
   TG Media Downloader — Light Theme
   Clean, modern desktop UI. Purple accent. Sidebar navigation.
   ═══════════════════════════════════════════════════════════════════════ */

/* ── Base ── */
* {
    font-family: "Segoe UI", "Inter", sans-serif;
    outline: none;
}
QWidget { font-size: 13px; color: #1C1C1E; }
QMainWindow { background: #F2F2F7; }
QWidget#CentralWidget { background: #F2F2F7; }
QScrollArea, QScrollArea > QWidget > QWidget { background: transparent; border: none; }

/* ── Scrollbar ── */
QScrollBar:vertical { background: transparent; width: 6px; margin: 2px; }
QScrollBar::handle:vertical { background: #C7C7CC; border-radius: 3px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #AEAEB2; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 6px; margin: 2px; }
QScrollBar::handle:horizontal { background: #C7C7CC; border-radius: 3px; min-width: 24px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ═══════════════════════════════════════════════════════════════════════
   SIDEBAR NAVIGATION
   ═══════════════════════════════════════════════════════════════════════ */
QWidget#Sidebar {
    background: #FFFFFF;
    border-right: 1px solid #E5E5EA;
    min-width: 200px;
    max-width: 200px;
}
QWidget#Sidebar QScrollArea,
QWidget#Sidebar QScrollArea > QWidget > QWidget,
QWidget#SidebarInner {
    background: #FFFFFF;
    border: none;
}
QWidget#BrandBlock { background: transparent; }
QLabel#BrandLogo { min-width: 32px; max-width: 32px; min-height: 32px; max-height: 32px; }
QLabel#BrandName {
    color: #1C1C1E;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0px;
}
QLabel#BrandVersion {
    color: #8E8E93;
    font-size: 10px;
}

/* Sidebar nav buttons */
QWidget#Sidebar QToolButton {
    background: transparent;
    color: #636366;
    border: none;
    border-radius: 8px;
    min-height: 38px;
    padding: 0 12px;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
}
QWidget#Sidebar QToolButton:hover {
    background: #F2F2F7;
    color: #1C1C1E;
}
QWidget#Sidebar QToolButton:checked {
    background: #EEE9F8;
    color: #6B3FA0;
    font-weight: 600;
}
QWidget#Sidebar QToolButton#LogoutBtn {
    color: #C0392B;
}
QWidget#Sidebar QToolButton#LogoutBtn:hover {
    background: #FFF0EE;
    color: #E74C3C;
}

/* ═══════════════════════════════════════════════════════════════════════
   CONTENT AREA
   ═══════════════════════════════════════════════════════════════════════ */
QWidget#ContentArea { background: #F2F2F7; }
QWidget#HomeContent { background: #F2F2F7; }

/* Status bar */
QStatusBar { background: #FFFFFF; border-top: 1px solid #E5E5EA; min-height: 26px; }
QStatusBar QLabel { color: #8E8E93; font-size: 11px; font-family: "Consolas"; }
QStatusBar::item { border: none; }

/* ═══════════════════════════════════════════════════════════════════════
   TYPOGRAPHY
   ═══════════════════════════════════════════════════════════════════════ */
QLabel { color: #1C1C1E; }
QLabel#PageTitle     { color: #1C1C1E; font-size: 22px; font-weight: 700; }
QLabel#PageSubtitle  { color: #8E8E93; font-size: 13px; }
QLabel#SectionHeader { color: #1C1C1E; font-size: 15px; font-weight: 650; }
QLabel#CardTitle     { color: #1C1C1E; font-size: 14px; font-weight: 650; }
QLabel#OptionTitle   { color: #1C1C1E; font-size: 13px; font-weight: 600; }
QLabel#MutedText     { color: #8E8E93; font-size: 12px; }
QLabel#DescriptionText { color: #48484A; font-size: 13px; }
QLabel#ControlLabel  { color: #3A3A3C; font-size: 12px; font-weight: 600; }
QLabel#Eyebrow       { color: #6B3FA0; font-size: 10px; font-weight: 700; letter-spacing: 1.5px; }

/* Hero labels */
QLabel#HeroTitle     { color: #FFFFFF; font-size: 24px; font-weight: 700; }
QLabel#MainHeader, QLabel#MainHeaderLarge, QLabel#DialogTitle {
    color: #1C1C1E; font-size: 22px; font-weight: 700;
}

/* Metric labels */
QLabel#MetricLabel { color: #AEAEB2; font-size: 10px; font-weight: 600; letter-spacing: 0.5px; }
QLabel#MetricValue { color: #A855F7; font-size: 20px; font-weight: 700; font-family: "Consolas"; }

/* Badges */
QLabel#SecureBadge {
    background: #F2F2F7;
    border: 1px solid #D1D1D6;
    color: #6B3FA0;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 10px; font-weight: 700;
}
QLabel#SectionIndex {
    background: #EEE9F8;
    color: #6B3FA0;
    border: none;
    border-radius: 6px;
    min-width: 26px; max-width: 26px;
    min-height: 26px; max-height: 26px;
    font-size: 9px; font-weight: 800;
    qproperty-alignment: AlignCenter;
}
QLabel#TypePill, QLabel#SizeBadge {
    background: #EEE9F8;
    color: #6B3FA0;
    border: none;
    border-radius: 5px;
    padding: 2px 8px;
    font-size: 11px; font-weight: 600;
}
QLabel#StatusBadge {
    border-radius: 5px;
    padding: 3px 8px;
    font-size: 11px; font-weight: 600;
}
QLabel#StatusBadge[state="active"]    { background: #EEE9F8; color: #6B3FA0; }
QLabel#StatusBadge[state="paused"]    { background: #FFF0EE; color: #C0392B; }
QLabel#StatusBadge[state="completed"] { background: #EAFAF1; color: #1E8449; }

QLabel#MediaTypeBadge {
    background: #EEE9F8;
    color: #6B3FA0;
    border: none;
    border-radius: 8px;
    min-width: 48px; max-width: 48px;
    min-height: 48px; max-height: 48px;
    font-size: 10px; font-weight: 800;
    font-family: "Consolas";
    qproperty-alignment: AlignCenter;
}
QLabel#MediaKindBadge {
    background: #EEE9F8;
    color: #6B3FA0;
    border: none;
    border-radius: 6px;
    min-height: 30px; max-height: 30px;
    padding: 0 8px;
    font-size: 10px; font-weight: 700;
    font-family: "Consolas";
}

/* Status marks (queue page) */
QLabel#LiveMark, QLabel#HistoryMark, QLabel#CompletedMark {
    min-width: 40px; max-width: 40px;
    min-height: 20px; max-height: 20px;
    border-radius: 5px;
    font-size: 9px; font-weight: 800;
    font-family: "Consolas";
    qproperty-alignment: AlignCenter;
}
QLabel#LiveMark      { background: #EEE9F8; color: #6B3FA0; }
QLabel#HistoryMark   { background: #F2F2F7; color: #636366; }
QLabel#CompletedMark { background: #EAFAF1; color: #1E8449; }

QLabel#DialogStatus { color: #6B3FA0; font-size: 11px; font-weight: 600; }
QLabel#MediaItemTitle { color: #1C1C1E; font-size: 13px; font-weight: 600; }
QLabel#MediaItemMeta { color: #8E8E93; font-size: 11px; }
QLabel#FileRowName   { color: #1C1C1E; font-size: 12px; }
QLabel#FileRowSize   { color: #8E8E93; font-size: 11px; }
QLabel#queueHeader   { color: #8E8E93; font-size: 10px; font-weight: 600; letter-spacing: 0.5px; }

/* Login specific */
QLabel#LoginBrandTitle { color: #FFFFFF; font-size: 26px; font-weight: 700; }

/* About dialog */
QLabel#AboutTitle { color: #1C1C1E; font-size: 22px; font-weight: 700; }
QLabel#DangerTitle { color: #C0392B; font-size: 13px; font-weight: 650; }

/* ═══════════════════════════════════════════════════════════════════════
   CARDS & PANELS
   ═══════════════════════════════════════════════════════════════════════ */

/* Primary hero card (dark bg) */
QFrame#HeroCard, QFrame#QueueHero, QFrame#BrowserHero, QFrame#AboutHero {
    background: #1C1C1E;
    border: none;
    border-radius: 14px;
}
QFrame#HeroCard QLabel#DescriptionText,
QFrame#QueueHero QLabel#DescriptionText {
    color: #AEAEB2;
}
QLabel#QueueHeroTitle { color: #FFFFFF; font-size: 20px; font-weight: 700; }

QFrame#MetricsPanel {
    background: #2C2C2E;
    border: none;
    border-radius: 10px;
}

/* Standard cards */
QFrame#WorkflowStep, QWidget#SourcePanel,
QFrame#SettingsSection, QFrame#QueueSection,
QFrame#DownloadCardFrame, QFrame#AboutFeature,
QFrame#LoginFormPanel, QFrame#FilterPanel,
QFrame#BulkOptions {
    background: #FFFFFF;
    border: 1px solid #E5E5EA;
    border-radius: 12px;
}
QFrame#WorkflowStep:hover { background: #FAFAFA; border-color: #D1D1D6; }
QFrame#DownloadCardFrame:hover { background: #FAFAFA; border-color: #C4B1E4; }

/* Inner option rows */
QFrame#SettingOption {
    background: #F9F9F9;
    border: 1px solid #EBEBEF;
    border-radius: 8px;
}
QFrame#SettingOption:hover { background: #F2F0F8; border-color: #C4B1E4; }
QFrame#FieldPanel {
    background: #F9F9F9;
    border: 1px solid #EBEBEF;
    border-radius: 8px;
}

/* Empty state */
QFrame#EmptyState {
    background: #FAFAFA;
    border: 1px dashed #D1D1D6;
    border-radius: 8px;
}

/* History row */
QFrame#HistoryRow {
    background: #FFFFFF;
    border: 1px solid #E5E5EA;
    border-radius: 8px;
}
QFrame#HistoryRow:hover { background: #F9F9F9; border-color: #D1D1D6; }

/* Login panels */
QFrame#LoginBrandPanel {
    background: #1C1C1E;
    border: none;
    border-radius: 14px;
}
QFrame#LoginBrandPanel QLabel#DescriptionText { color: #AEAEB2; }
QFrame#LoginFeature {
    background: #2C2C2E;
    border: none;
    border-radius: 8px;
}
QFrame#LoginFeature QLabel#OptionTitle { color: #F5F5F7; }
QFrame#LoginFeature QLabel#MutedText   { color: #AEAEB2; }

/* Danger zone */
QFrame#DangerCard {
    background: #FFF9F9;
    border: 1px solid #F5C6C6;
    border-radius: 12px;
}

/* Dialog */
QDialog { background: #FFFFFF; }
QDialog#AboutDialog { background: #F2F2F7; }
QDialog#MediaBrowserDialog { background: #FFFFFF; }
QWidget#BulkView { background: #FFFFFF; }

/* Toolbar / footer frames */
QFrame#BrowserToolbar, QFrame#DialogFooter {
    background: #FAFAFA;
    border: 1px solid #E5E5EA;
    border-radius: 10px;
}

/* ── Settings ── */
QFrame#SettingsPanel { background: transparent; border: none; }

/* Workflow strip */
QFrame#WorkflowStrip { background: transparent; border: none; }

/* Expand area (file list) */
QFrame#expandArea {
    background: #F9F9F9;
    border: 1px solid #E5E5EA;
    border-top: none;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

/* File rows */
QWidget#FileRow { border-bottom: 1px solid #EBEBEF; }
QWidget#FileRow[alt="true"]  { background: #FAFAFA; }
QWidget#FileRow[alt="false"] { background: #FFFFFF; }

/* Dividers */
QFrame#Divider, QFrame#DividerHorizontal {
    background: #E5E5EA;
    border: none;
    max-height: 1px;
}

/* ═══════════════════════════════════════════════════════════════════════
   FORM CONTROLS
   ═══════════════════════════════════════════════════════════════════════ */
QLineEdit, QSpinBox, QComboBox, QDateEdit {
    background: #FFFFFF;
    color: #1C1C1E;
    border: 1.5px solid #D1D1D6;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: #9562E3;
    selection-color: #FFFFFF;
}
QLineEdit:hover, QSpinBox:hover, QComboBox:hover, QDateEdit:hover {
    border-color: #AEAEB2;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus, QDateEdit:focus {
    border: 2px solid #9562E3;
    background: #FFFFFF;
}
QLineEdit:disabled, QSpinBox:disabled, QComboBox:disabled, QDateEdit:disabled {
    background: #F2F2F7;
    color: #AEAEB2;
    border-color: #E5E5EA;
}

/* ComboBox dropdown */
QComboBox {
    padding: 6px 26px 6px 10px;
    min-width: 90px;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    background: transparent;
    border: none;
}
QComboBox::drop-down:hover { background: transparent; }
QComboBox::down-arrow {
    image: url("__ICONS_DIR__/control-chevron-down.svg");
    width: 10px; height: 10px;
}
QComboBox QAbstractItemView {
    background: #FFFFFF;
    color: #1C1C1E;
    border: 1px solid #D1D1D6;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #EEE9F8;
    selection-color: #6B3FA0;
    outline: none;
}

/* SpinBox */
QSpinBox { padding-right: 32px; }
QSpinBox::up-button, QSpinBox::down-button {
    subcontrol-origin: border;
    width: 28px;
    background: #F2F2F7;
    border: none;
    border-left: 1.5px solid #D1D1D6;
}
QSpinBox::up-button {
    subcontrol-position: top right;
    border-bottom: 1px solid #D1D1D6;
    border-top-right-radius: 7px;
}
QSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 7px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background: #EBEBEF; }
QSpinBox::up-arrow   { image: url("__ICONS_DIR__/control-plus.svg");  width: 10px; height: 10px; }
QSpinBox::down-arrow { image: url("__ICONS_DIR__/control-minus.svg"); width: 10px; height: 10px; }

/* ═══════════════════════════════════════════════════════════════════════
   BUTTONS
   ═══════════════════════════════════════════════════════════════════════ */
QPushButton {
    min-height: 32px;
    border-radius: 8px;
    padding: 0 14px;
    font-size: 13px;
    font-weight: 600;
    border: none;
}

/* Primary — filled purple */
QPushButton#PrimaryButton, QPushButton#PrimaryButtonLarge, QPushButton#SuccessButton {
    background: #9562E3;
    color: #FFFFFF;
    border: none;
}
QPushButton#PrimaryButton:hover, QPushButton#PrimaryButtonLarge:hover, QPushButton#SuccessButton:hover {
    background: #8451D1;
}
QPushButton#PrimaryButton:pressed, QPushButton#PrimaryButtonLarge:pressed, QPushButton#SuccessButton:pressed {
    background: #7545BC;
}
QPushButton#PrimaryButton:disabled, QPushButton#PrimaryButtonLarge:disabled, QPushButton#SuccessButton:disabled {
    background: #D1D1D6;
    color: #AEAEB2;
}

/* Secondary — ghost */
QPushButton#SecondaryButton, QPushButton#CardButton,
QPushButton#CardButtonCompact, QPushButton#PrimaryRowButton {
    background: #FFFFFF;
    color: #3A3A3C;
    border: 1.5px solid #D1D1D6;
}
QPushButton#SecondaryButton:hover, QPushButton#CardButton:hover,
QPushButton#CardButtonCompact:hover, QPushButton#PrimaryRowButton:hover {
    background: #F2F0F8;
    color: #6B3FA0;
    border-color: #C4B1E4;
}

/* Link / expand */
QPushButton#LinkButton, QPushButton#ExpandButton {
    background: transparent;
    color: #6B3FA0;
    border: none;
    padding: 4px 6px;
    text-align: left;
    font-weight: 500;
}
QPushButton#LinkButton:hover, QPushButton#ExpandButton:hover { color: #9562E3; }

/* Logout / danger */
QPushButton#LogoutBtn {
    background: transparent;
    color: #C0392B;
    border: 1.5px solid #F5C6C6;
}
QPushButton#LogoutBtn:hover {
    background: #FFF0EE;
    color: #E74C3C;
    border-color: #E74C3C;
}

/* Support */
QPushButton#SupportButton {
    background: #FFCC00;
    color: #1C1C1E;
    border: none;
    border-radius: 8px;
    min-height: 30px;
    padding: 0 12px;
    font-size: 12px; font-weight: 700;
}
QPushButton#SupportButton:hover { background: #F0C000; }

/* Topic dialog buttons */
QPushButton#TopicCancelBtn {
    background: #F2F2F7;
    color: #3A3A3C;
    border: 1px solid #D1D1D6;
    border-radius: 8px;
    min-height: 34px;
    font-size: 13px; font-weight: 600;
}
QPushButton#TopicCancelBtn:hover { background: #EBEBEF; border-color: #C4B1E4; }
QPushButton#TopicContinueBtn {
    background: #9562E3;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    min-height: 34px;
    font-size: 13px; font-weight: 600;
}
QPushButton#TopicContinueBtn:hover { background: #8451D1; }

/* Dialog tool buttons */
QDialog QToolButton {
    background: #FFFFFF;
    color: #3A3A3C;
    border: 1.5px solid #D1D1D6;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 12px; font-weight: 600;
    min-height: 28px;
}
QDialog QToolButton:hover, QDialog QToolButton:checked {
    background: #F2F0F8;
    color: #6B3FA0;
    border-color: #C4B1E4;
}

/* Generic QToolButton used outside dialogs (e.g. BrowserToolbar) */
QToolButton {
    background: #FFFFFF;
    color: #3A3A3C;
    border: 1.5px solid #D1D1D6;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 13px; font-weight: 600;
    min-height: 30px;
}
QToolButton:hover {
    background: #F2F0F8;
    color: #6B3FA0;
    border-color: #C4B1E4;
}
QToolButton:checked {
    background: #EEE9F8;
    color: #6B3FA0;
    border-color: #9562E3;
}
/* Don't let the generic rule override sidebar nav buttons */
QWidget#Sidebar QToolButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #636366;
    padding: 0 12px;
    min-height: 38px;
    font-size: 13px; font-weight: 500;
}

/* ═══════════════════════════════════════════════════════════════════════
   CHECKBOX / TOGGLE
   ═══════════════════════════════════════════════════════════════════════ */
QCheckBox { spacing: 8px; color: #3A3A3C; font-size: 13px; }
QCheckBox::indicator {
    width: 18px; height: 18px;
    background: #FFFFFF;
    border: 1.5px solid #D1D1D6;
    border-radius: 5px;
}
QCheckBox::indicator:checked {
    background: #9562E3;
    border-color: #9562E3;
}
QCheckBox#ToggleSwitch {
    min-width: 42px; max-width: 42px;
    min-height: 24px; max-height: 24px;
    background: transparent;
    border: none;
    padding: 0;
}

/* ═══════════════════════════════════════════════════════════════════════
   PROGRESS BAR
   ═══════════════════════════════════════════════════════════════════════ */
QProgressBar {
    background: #E5E5EA;
    color: #3A3A3C;
    border: none;
    border-radius: 5px;
    font-size: 10px; font-weight: 700;
    font-family: "Consolas";
    text-align: center;
}
QProgressBar::chunk { background: #9562E3; border-radius: 5px; }
QProgressBar[state="paused"]::chunk   { background: #AEAEB2; }
QProgressBar[state="completed"]::chunk { background: #34C759; }
QProgressBar#FileProgressBar { min-height: 4px; max-height: 4px; border-radius: 2px; }

/* ═══════════════════════════════════════════════════════════════════════
   TABS
   ═══════════════════════════════════════════════════════════════════════ */
QTabWidget#MediaTabs::pane {
    background: #FFFFFF;
    border: 1px solid #E5E5EA;
    border-radius: 10px;
}
QTabBar::tab {
    background: transparent;
    color: #8E8E93;
    border-bottom: 2px solid transparent;
    padding: 8px 14px;
    font-size: 12px; font-weight: 600;
}
QTabBar::tab:selected { color: #6B3FA0; border-bottom-color: #9562E3; }
QTabBar::tab:hover:!selected { color: #3A3A3C; }

/* Tab bar scroller buttons (when tabs overflow) */
QTabBar QToolButton {
    background: #FFFFFF;
    border: 1.5px solid #D1D1D6;
    border-radius: 6px;
    margin: 2px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    padding: 0;
}
QTabBar QToolButton:hover {
    background: #F2F0F8;
    border-color: #C4B1E4;
}
QTabBar QToolButton:pressed {
    background: #EEE9F8;
    border-color: #9562E3;
}
QTabBar::left-button {
    qproperty-icon: url("__ICONS_DIR__/control-chevron-left.svg");
    qproperty-iconSize: 12px 12px;
}
QTabBar::right-button {
    qproperty-icon: url("__ICONS_DIR__/control-chevron-right.svg");
    qproperty-iconSize: 12px 12px;
}

/* ═══════════════════════════════════════════════════════════════════════
   SELECTABLE ROWS (media browser)
   ═══════════════════════════════════════════════════════════════════════ */
QWidget#SelectableRow {
    background: #FFFFFF;
    border: 1px solid #E5E5EA;
    border-radius: 8px;
}
QWidget#SelectableRow:hover { background: #F5F3FA; border-color: #C4B1E4; }
QWidget#SelectableRow[checked="true"] { background: #EEE9F8; border-color: #9562E3; }

/* ═══════════════════════════════════════════════════════════════════════
   CALENDAR
   ═══════════════════════════════════════════════════════════════════════ */
QCalendarWidget { background: #FFFFFF; color: #1C1C1E; }
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background: #F2F2F7;
    border-bottom: 1px solid #E5E5EA;
    min-height: 44px;
}

/* All nav bar tool buttons — reset first */
QCalendarWidget QToolButton {
    background: transparent;
    color: #1C1C1E;
    border: none;
    border-radius: 0;
    padding: 0;
    min-width: 0;
    min-height: 0;
    font-size: 13px;
    font-weight: 600;
}

/* ◀ Prev month */
QCalendarWidget QToolButton#qt_calendar_prevmonth {
    background: #FFFFFF;
    color: #3A3A3C;
    border: 1.5px solid #D1D1D6;
    border-radius: 8px;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 0;
    qproperty-icon: url("__ICONS_DIR__/control-chevron-left.svg");
    qproperty-iconSize: 14px 14px;
}
QCalendarWidget QToolButton#qt_calendar_prevmonth::menu-button { width: 0; }
QCalendarWidget QToolButton#qt_calendar_prevmonth:hover {
    background: #F2F0F8;
    border-color: #C4B1E4;
}
QCalendarWidget QToolButton#qt_calendar_prevmonth:pressed {
    background: #EEE9F8;
    border-color: #9562E3;
}

/* ▶ Next month */
QCalendarWidget QToolButton#qt_calendar_nextmonth {
    background: #FFFFFF;
    color: #3A3A3C;
    border: 1.5px solid #D1D1D6;
    border-radius: 8px;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 0;
    qproperty-icon: url("__ICONS_DIR__/control-chevron-right.svg");
    qproperty-iconSize: 14px 14px;
}
QCalendarWidget QToolButton#qt_calendar_nextmonth::menu-button { width: 0; }
QCalendarWidget QToolButton#qt_calendar_nextmonth:hover {
    background: #F2F0F8;
    border-color: #C4B1E4;
}
QCalendarWidget QToolButton#qt_calendar_nextmonth:pressed {
    background: #EEE9F8;
    border-color: #9562E3;
}

/* Month label (centre) */
QCalendarWidget QToolButton#qt_calendar_monthmenu {
    color: #1C1C1E;
    font-size: 14px;
    font-weight: 700;
    background: transparent;
    border: none;
    padding: 0 4px;
}
QCalendarWidget QToolButton#qt_calendar_monthmenu:hover {
    color: #6B3FA0;
}

/* Year spinbox */
QCalendarWidget QSpinBox {
    border: 1.5px solid #D1D1D6;
    border-radius: 6px;
    padding: 2px 6px;
    background: #FFFFFF;
    color: #1C1C1E;
    font-weight: 700;
}
QCalendarWidget QSpinBox::up-button,
QCalendarWidget QSpinBox::down-button { width: 0; }

QCalendarWidget QMenu {
    background: #FFFFFF;
    border: 1px solid #D1D1D6;
    border-radius: 8px;
}
QCalendarWidget QAbstractItemView {
    background: #FFFFFF;
    color: #1C1C1E;
    selection-background-color: #9562E3;
    selection-color: #FFFFFF;
    gridline-color: #F2F2F7;
}

/* ═══════════════════════════════════════════════════════════════════════
   MENUS & TOOLTIPS
   ═══════════════════════════════════════════════════════════════════════ */
QMenu, QToolTip {
    background: #FFFFFF;
    color: #1C1C1E;
    border: 1px solid #D1D1D6;
    border-radius: 10px;
    padding: 4px;
}
QMenu::item { padding: 7px 20px 7px 10px; border-radius: 6px; }
QMenu::item:selected { background: #EEE9F8; color: #6B3FA0; }

/* ═══════════════════════════════════════════════════════════════════════
   TOPIC PICKER DIALOG
   ═══════════════════════════════════════════════════════════════════════ */
QDialog#TopicPickerDialog { background: #FFFFFF; border-radius: 12px; }
QFrame#TopicHeader { background: #FFFFFF; border-bottom: 1px solid #E5E5EA; }
QLabel#TopicTitle { color: #1C1C1E; font-size: 17px; font-weight: 700; }
QLabel#TopicDesc  { color: #8E8E93; font-size: 12px; }
QFrame#TopicListFrame { background: #FFFFFF; }
QListWidget#TopicList {
    background: transparent;
    border: none;
    outline: none;
    padding: 4px 0;
}
QListWidget#TopicList::item {
    background: #F9F9F9;
    color: #1C1C1E;
    border: 1px solid #E5E5EA;
    border-radius: 8px;
    padding: 10px 14px;
    margin: 2px 0;
    font-size: 13px;
}
QListWidget#TopicList::item:hover { background: #F0EDF8; border-color: #C4B1E4; }
QListWidget#TopicList::item:selected {
    background: #9562E3;
    border: 1px solid #9562E3;
    color: #FFFFFF;
    font-weight: 600;
}
QFrame#TopicFooter { background: #FFFFFF; border-top: 1px solid #E5E5EA; }
